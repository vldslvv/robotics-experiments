#!/bin/sh
#
# @name Generic Hexarotor x SITL
#
# @type Hexarotor x
#
# SITL hexarotor for the external MAVLink simulator interface (Pegasus/Isaac
# provides dynamics over MAVLink). Modeled on the stock 10016_none_iris SITL
# quad (sources rc.mc_defaults, sets CA_AIRFRAME and PWM_MAIN_FUNC*). Like every
# non-gz/sih/jmavsim airframe it falls through to
# `simulator_mavlink start -c $((4560+i))` in px4-rc.simulator, so the PX4 bridge
# connects exactly as it does for the quad. Baked into the image by the px4 stage
# of the repo Dockerfile.
#
# The CA_ROTOR control-allocation geometry below is authored to match the
# physical rotor layout of the hexacopter_s550.usda asset
# (configs/usd_builder/drone/hexacopter_s550.yaml), ordered by px4_motor_index,
# so PX4 motor output 101+i is modeled at the same place and spin the bridge
# physically drives it. This deliberately departs from the canonical 6001_hexa_x
# geometry (which clocks rotors at +/-30/+/-90/+/-150 deg and is NOT index-aligned
# with this asset); see docs/HEXACOPTER_SITL_FLIGHT_TUNING.md. Mapping:
#   - Position: asset arm = R*(cos az, sin az) in body FLU (R = 0.275 m boom
#     radius). PX4 CA_ROTOR is body FRD, so PX = x_FLU = R*cos(az),
#     PY = -y_FLU = -R*sin(az).
#   - Spin -> KM sign (calibrated against the working none_iris quad mapping):
#     CW -> +0.05, CCW -> -0.05.
# Per index (az / spin): 0:0deg/CCW 1:60/CW 2:120/CCW 3:180/CW 4:-120/CCW 5:-60/CW.
#

. ${R}etc/init.d/rc.mc_defaults

param set-default CA_AIRFRAME 0

# MAV_TYPE_HEXAROTOR 13
param set-default MAV_TYPE 13

param set-default CA_ROTOR_COUNT 6
param set-default CA_ROTOR0_PX 0.275
param set-default CA_ROTOR0_PY 0.0
param set-default CA_ROTOR0_KM -0.05
param set-default CA_ROTOR1_PX 0.1375
param set-default CA_ROTOR1_PY -0.2382
param set-default CA_ROTOR1_KM 0.05
param set-default CA_ROTOR2_PX -0.1375
param set-default CA_ROTOR2_PY -0.2382
param set-default CA_ROTOR2_KM -0.05
param set-default CA_ROTOR3_PX -0.275
param set-default CA_ROTOR3_PY 0.0
param set-default CA_ROTOR3_KM 0.05
param set-default CA_ROTOR4_PX -0.1375
param set-default CA_ROTOR4_PY 0.2382
param set-default CA_ROTOR4_KM -0.05
param set-default CA_ROTOR5_PX 0.1375
param set-default CA_ROTOR5_PY 0.2382
param set-default CA_ROTOR5_KM 0.05

param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104
param set-default PWM_MAIN_FUNC5 105
param set-default PWM_MAIN_FUNC6 106
