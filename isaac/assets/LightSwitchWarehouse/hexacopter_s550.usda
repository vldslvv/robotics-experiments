    def PhysicsPrismaticJoint "pusher_joint" (
        apiSchemas = ["PhysicsDriveAPI:linear"]
    )
    {
        float drive:linear:physics:damping = 40
        float drive:linear:physics:stiffness = 800
        uniform token drive:linear:physics:type = "force"
        uniform token physics:axis = "X"
        rel physics:body0 = </hexacopter/body>
        rel physics:body1 = </hexacopter/pusher/pad>
        point3f physics:localPos0 = (0.13, 0, 0.01)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (1, 0, 0, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
